{
  "name": "dictaphone-opencode",
  "version": "0.1.0",
  "description": "Local, offline Whisper dictation plugin for OpenCode Desktop.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "exports": {
    ".": "./server.js",
    "./gui-experimental": "./gui-experimental.cjs"
  },
  "files": [
    "server.js",
    "gui-experimental.cjs",
    "scripts",
    "README.md",
    "README.fr.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check server.js && node --check gui-experimental.cjs"
  },
  "keywords": [
    "opencode",
    "opencode-desktop",
    "dictaphone",
    "whisper",
    "whisper.cpp",
    "dictation",
    "speech-to-text",
    "stt"
  ],
  "license": "MIT",
  "author": "Dictaphone OpenCode contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/railboz/dictaphone-opencode.git"
  },
  "bugs": {
